{
  "name": "mojo",
  "description": "Modular MAX (Mojo) nightly.",
  "image": "ghcr.io/jesserobertson/base-cuda-slim:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "features": {
    "ghcr.io/jesserobertson/devcontainers/mojo:latest": {}
  },
  "runArgs": ["--gpus", "all"],
  "mounts": [
    "source=pixi-cache,target=/home/dev/.cache/pixi,type=volume"
  ],
  "postCreateCommand": "mkdir -p ~/.config/pixi && printf 'detached-environments = true\\n' >> ~/.config/pixi/config.toml && pixi install",
  "remoteUser": "dev"
}
